# Copy to .env and fill in. Never commit .env. Vercel/Render: set these in the dashboard (docs/DEPLOYMENT.md).

# --- API (FastAPI container) ---
# Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
# Optional. Empty = caching off. Managed Redis: a rediss:// TCP URL (KV_URL is also accepted).
REDIS_URL=redis://localhost:6379
# Vercel container only: the port the image listens on (Vercel routes to 80 unless PORT is set).
PORT=8000
# Comma-separated browser origins for CORS (only needed if a browser calls the API directly)
ALLOWED_ORIGINS=http://localhost:8501

# --- UI (Streamlit) ---
# Local / Render only. On Vercel the private binding injects API_INTERNAL_URL instead; never set it yourself.
BACKEND_URL=http://localhost:8000
